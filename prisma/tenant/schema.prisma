generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/prisma-tenant"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  passwordHash   String?
  role           String    @default("MEMBER")
  permissions    String?
  linkedMemberId String?
  active         Boolean   @default(true)
  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
}

model Member {
  id                      String    @id @default(cuid())
  name                    String
  email                   String
  phone                   String
  teamIds                 String?
  parentPhone             String?
  creditBalance           Float     @default(0)
  active                  Boolean   @default(true)
  approved                Boolean   @default(false)
  birthDate               DateTime?
  conversionDate          DateTime?
  baptismDate             DateTime?
  previousChurch          String?
  aboutMe                 String?
  maritalStatus           String?
  passwordHash            String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?
}

model Product {
  id             String    @id @default(cuid())
  name           String
  description    String?
  imageUrl       String?
  price          Float
  cost           Float
  stock          Int       @default(0)
  minStock       Int       @default(0)
  category       String
  active         Boolean   @default(true)
  availableToday Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
}

model Sale {
  id            String    @id @default(cuid())
  total         Float
  paymentMethod String
  items         String
  memberId      String?
  memberName    String?
  createdBy     String
  orderStatus   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
}

model CreditTransaction {
  id         String    @id @default(cuid())
  memberId   String
  memberName String?
  type       String
  amount     Float
  saleId     String?
  notes      String?
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
}

model Notification {
  id         String    @id @default(cuid())
  userEmail  String
  type       String
  title      String
  message    String
  href       String?
  sourceType String?
  sourceId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  teamId      String
  assignedTo  String?
  date        DateTime
  status      String    @default("pending")
  type        String
  recurrence  String    @default("none")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model Team {
  id          String    @id @default(cuid())
  name        String
  description String?
  color       String
  icon        String
  leaderIds   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model TeamJoinRequest {
  id         String    @id @default(cuid())
  memberId   String
  memberName String
  teamId     String
  teamName   String
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
}

model Material {
  id          String    @id @default(cuid())
  teamId      String?
  name        String
  category    String
  quantity    Int       @default(0)
  minQuantity Int       @default(0)
  unit        String    @default("unidades")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model Group {
  id           String    @id @default(cuid())
  name         String
  description  String?
  type         String    @default("team")
  capabilities String    @default("[]")
  color        String    @default("primary")
  icon         String    @default("users")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

model GroupMember {
  id        String    @id @default(cuid())
  groupId   String
  memberId  String
  role      String    @default("member")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model FundraisingGoal {
  id           String    @id @default(cuid())
  groupId      String
  title        String
  description  String?
  targetAmount Float     @default(0)
  currentAmount Float    @default(0)
  items        String    @default("[]")
  deadline     DateTime?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

model ChildProfile {
  id                      String    @id @default(cuid())
  name                    String
  birthDate               DateTime?
  parentMemberIds         String    @default("[]")
  allergies               String?
  medications             String?
  healthHistory           String?
  dietaryRestrictions     String?
  canDoPhysicalActivities Boolean   @default(true)
  notes                   String?
  groupIds                String    @default("[]")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?
}

model ParkingSpot {
  id                 String    @id @default(cuid())
  groupId            String
  label              String
  status             String    @default("free")
  occupiedByMemberId String?
  occupiedByName     String?
  notes              String?
  occupiedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
}

model FeedPost {
  id            String    @id @default(cuid())
  userId        String
  userName      String
  userAvatar    String?
  senderType    String    @default("user")
  senderGroupId String?
  type          String
  title         String?
  content       String
  reference     String?
  mediaUrl      String?
  mediaType     String?
  visibility    String    @default("public")
  groupId       String?
  pinnedUntil   DateTime?
  targetUserIds String?
  readBy        String?
  likes         String    @default("[]")
  comments      String    @default("[]")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
}

model QuizQuestion {
  id           String    @id @default(cuid())
  question     String
  options      String
  correctIndex Int
  category     String
  difficulty   String
  points       Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

model QuizAttempt {
  id             String    @id @default(cuid())
  userId         String
  userName       String
  score          Int
  totalQuestions Int
  correctAnswers Int
  completedAt    DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
}

model EngagementProfile {
  id                    String    @id @default(cuid())
  userEmail             String    @unique
  devotionalStreak      Int       @default(0)
  devotionalLastDate    String?
  completedChallengeIds String    @default("[]")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?
}

model Book {
  id        String    @id @default(cuid())
  name      String
  abbrev    String    @unique
  testament String
  chapters  Chapter[]
}

model Chapter {
  id      String   @id @default(cuid())
  number  Int
  bookId  String
  book    Book     @relation(fields: [bookId], references: [id])
  verses  Verse[]
}

model Verse {
  id        String  @id @default(cuid())
  number    Int
  text      String
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id])
}

model CanteenSettings {
  id        String   @id
  isOpen    Boolean  @default(false)
  openedAt  DateTime?
  closedAt  DateTime?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
