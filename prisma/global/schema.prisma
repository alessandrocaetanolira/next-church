generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/prisma-global"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Church {
  id           String   @id @default(cuid())
  slug         String   @unique
  databaseKey  String?  @unique
  name         String
  logoUrl      String?
  themeVariant String?  @default("default")
  themeMode    String?  @default("light")
  plan         String   @default("FREE")
  status       String   @default("ACTIVE")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?
  provisioningStartedAt DateTime?
  provisionedAt DateTime?
  provisioningError String?
}

model PlatformAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("SUPER_ADMIN")
  permissions  String?
  active       Boolean  @default(true)
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Plan {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  description   String?
  priceCents    Int      @default(0)
  maxUsers      Int?
  maxStorageMb  Int?
  features      String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
