generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/prisma-global"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Church {
  id           String   @id @default(cuid())
  slug         String   @unique
  databaseKey  String?  @unique
  name         String
  logoUrl      String?
  themeVariant String?  @default("default")
  themeMode    String?  @default("light")
  plan         String   @default("FREE")
  status       String   @default("ACTIVE")
  active       Boolean  @default(true)
  authVersion  Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?
  provisioningStartedAt DateTime?
  provisionedAt DateTime?
  provisioningError String?
  branding      ChurchBranding?
  provisioningJobs ProvisioningJob[]
}

model ProvisioningJob {
  id                String   @id @default(cuid())
  runId             String   @unique
  churchId          String?
  slug              String
  adminEmail        String
  platformAdminId   String?
  status            String   @default("QUEUED")
  step              String?
  attempts          Int      @default(0)
  error             String?
  createdAt         DateTime @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?
  updatedAt         DateTime @updatedAt
  church            Church?  @relation(fields: [churchId], references: [id], onDelete: SetNull)

  @@index([churchId])
  @@index([status])
}

model ChurchBranding {
  id                  String   @id @default(cuid())
  churchId            String   @unique
  pwaName             String?
  pwaShortName        String?
  logoUrl             String?
  logoLightUrl        String?
  logoDarkUrl         String?
  mobileIconUrl       String?
  sidebarLogoUrl      String?
  sidebarOpenLightUrl String?
  sidebarOpenDarkUrl  String?
  sidebarCollapsedLightUrl String?
  sidebarCollapsedDarkUrl  String?
  sidebarUseImage     Boolean  @default(true)
  sidebarTitle        String?
  sidebarSubtitle     String?
  icon192Url          String?
  icon512Url          String?
  primaryColor        String?
  secondaryColor      String?
  themeColor          String?
  backgroundColor     String?
  configJson          String?
  schemaVersion       Int      @default(1)
  brandingVersion     Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  church              Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
}

model PlatformAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("SUPER_ADMIN")
  permissions  String?
  active       Boolean  @default(true)
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  pushSubscriptions PlatformPushSubscription[]
  notifications PlatformNotification[]
}

model Plan {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  description   String?
  priceCents    Int      @default(0)
  maxUsers      Int?
  maxStorageMb  Int?
  features      String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PlatformPushSubscription {
  id String @id @default(cuid())
  adminId String
  endpoint String @unique
  p256dh String
  auth String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  @@index([adminId])
}

model PlatformNotification {
  id String @id @default(cuid())
  adminId String
  type String
  title String
  message String
  href String?
  readAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  @@index([adminId, createdAt])
}
